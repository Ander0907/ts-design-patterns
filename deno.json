{
  "tasks": {
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "prettier": "deno run --allow-read --allow-write npm:prettier --write .",
    "prettier:check": "deno run --allow-read npm:prettier --check ."
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["**/*.ts", "**/*.js", "**/*.json", "**/*.md"],
    "exclude": ["node_modules/", "dist/", "build/"]
  }
}
